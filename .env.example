# TiDB Cloud database URL (get from tidbcloud.com → Connect → General)
DATABASE_URL="mysql://user:password@host:4000/dbname?sslaccept=strict"

# Twilio credentials (get from console.twilio.com)
TWILIO_ACCOUNT_SID="ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
TWILIO_AUTH_TOKEN="your_auth_token"
TWILIO_WHATSAPP_NUMBER="+14155238886"
TWILIO_SMS_NUMBER="+1xxxxxxxxxx"

# JWT secret for admin dashboard auth (generate with: openssl rand -hex 32)
JWT_SECRET="your_64_char_hex_secret"

# Public app URL — no trailing slash (your Vercel deployment URL)
NEXT_PUBLIC_APP_URL="https://your-app.vercel.app"

# OpenRouter API key for AI order parsing and brief reformatting
# Get from openrouter.ai — free tier works with google/gemma-4-31b-it:free
OPENROUTER_API_KEY="sk-or-v1-..."

# Razorpay keys for payment integration (get from dashboard.razorpay.com)
RAZORPAY_KEY_ID="rzp_live_xxxxxxxxxxxxxxxx"
NEXT_PUBLIC_RAZORPAY_KEY_ID="rzp_live_xxxxxxxxxxxxxxxx"
RAZORPAY_KEY_SECRET="your_razorpay_secret"

# Unsplash API keys for menu item images (get from unsplash.com/developers)
UNSPLASH_ACCESS_KEY="your_access_key"
UNSPLASH_SECRET_KEY="your_secret_key"

# Seeded demo tenant ID (set after running the seed script)
SEED_TENANT_ID="uuid-of-first-tenant"

# Development only — bypasses Twilio signature validation (never set in production)
# TEST_WEBHOOK_BYPASS="true"
