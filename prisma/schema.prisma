generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider     = "mysql"
  relationMode = "prisma"
}

enum FieldType {
  text
  number
  select
  boolean
}

model Tenant {
  id                  String   @id @default(uuid())
  businessName        String   @db.VarChar(100)
  businessType        String   @default("bakery") @db.VarChar(50)
  ownerPhone          String   @db.VarChar(20)
  otpNumber           String   @default("+917010044626") @db.VarChar(20)
  whatsappNumber      String   @unique @db.VarChar(20)
  logoUrl             String?  @db.VarChar(500)
  address             String?  @db.Text
  currency            String   @default("INR") @db.VarChar(3)
  minOrderAmount      Int      @default(0)
  deliveryDateEnabled Boolean  @default(true)
  deliveryDateLabel   String   @default("When would you like your order?") @db.VarChar(200)
  // Operating hours
  timezone            String   @default("Asia/Kolkata") @db.VarChar(50)
  openDays            String   @default("1,2,3,4,5,6") @db.VarChar(20)
  openTime            String   @default("09:00") @db.VarChar(5)
  closeTime           String   @default("21:00") @db.VarChar(5)
  // Payment integration
  razorpayKeyId       String?  @db.VarChar(100)
  razorpayKeySecret   String?  @db.VarChar(200)
  // Social / web presence
  websiteUrl          String?  @db.VarChar(500)
  instagramUrl        String?  @db.VarChar(500)
  facebookUrl         String?  @db.VarChar(500)
  active              Boolean  @default(true)
  hasCart             Boolean  @default(true)
  hasBooking          Boolean  @default(false)
  hasEnquiry          Boolean  @default(false)
  hasDelivery         Boolean  @default(true)
  deliveryZones  String?  @db.Text
  createdAt           DateTime @default(now())

  @@map("tenants")
}

model MenuCategory {
  id        String          @id @default(uuid())
  tenantId  String?         @db.VarChar(36)
  name      String          @db.VarChar(100)
  sortOrder Int             @default(0)
  active    Boolean         @default(true)
  isCustom  Boolean         @default(false)
  items     MenuItem[]
  fields    CategoryField[]

  @@index([tenantId])
  @@map("menu_categories")
}

model MenuItem {
  id           String           @id @default(uuid())
  tenantId     String?          @db.VarChar(36)
  categoryId   String
  category     MenuCategory     @relation(fields: [categoryId], references: [id])
  name         String           @db.VarChar(100)
  description  String?          @db.Text
  price        Int
  imageUrl     String?          @db.VarChar(500)
  productUrl   String?          @db.VarChar(500)
  available    Boolean          @default(true)
  sortOrder    Int              @default(0)
  orderItems   OrderItem[]
  fieldOptions ItemFieldOption[]

  @@index([tenantId])
  @@index([categoryId])
  @@map("menu_items")
}

model CategoryField {
  id          String                @id @default(uuid())
  tenantId    String                @db.VarChar(36)
  categoryId  String
  category    MenuCategory          @relation(fields: [categoryId], references: [id])
  name        String                @db.VarChar(100)
  type        FieldType
  required    Boolean               @default(true)
  placeholder String?               @db.VarChar(200)
  sortOrder   Int                   @default(0)
  options     CategoryFieldOption[]
  itemOptions ItemFieldOption[]

  @@unique([categoryId, name])
  @@index([categoryId])
  @@index([tenantId])
  @@map("category_fields")
}

model CategoryFieldOption {
  id          String           @id @default(uuid())
  fieldId     String
  field       CategoryField    @relation(fields: [fieldId], references: [id])
  label       String           @db.VarChar(100)
  priceDelta  Int              @default(0)
  sortOrder   Int              @default(0)
  itemOptions ItemFieldOption[]

  @@index([fieldId])
  @@map("category_field_options")
}

model ItemFieldOption {
  id         String              @id @default(uuid())
  menuItemId String
  menuItem   MenuItem            @relation(fields: [menuItemId], references: [id])
  fieldId    String
  field      CategoryField       @relation(fields: [fieldId], references: [id])
  optionId   String
  option     CategoryFieldOption @relation(fields: [optionId], references: [id])

  @@unique([menuItemId, optionId])
  @@index([menuItemId])
  @@index([fieldId])
  @@index([optionId])
  @@map("item_field_options")
}

model Order {
  id             String        @id @default(uuid())
  tenantId       String?       @db.VarChar(36)
  customerPhone  String        @db.VarChar(20)
  customerName   String        @db.VarChar(100)
  status         OrderStatus   @default(PENDING)
  totalAmount    Int
  discountCode   String?       @db.VarChar(50)
  discountAmount Int           @default(0)
  deliveryNote   String?       @db.VarChar(300)
  paymentLinkId  String?       @db.VarChar(100)
  paymentLinkUrl String?       @db.VarChar(500)
  notes          String?       @db.Text
  paymentMethod  String        @default("ONLINE") @db.VarChar(10)
  advancePaid    Boolean  @default(false)
  advanceAmount  Int      @default(0)
  bakerNotifiedAt DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  items          OrderItem[]
  messages       Message[]
  feedback       OrderFeedback?
  booking        Booking?

  @@index([tenantId])
  @@index([customerPhone])
  @@index([status])
  @@map("orders")
}

model OrderItem {
  id         String   @id @default(uuid())
  orderId    String
  order      Order    @relation(fields: [orderId], references: [id])
  menuItemId String
  menuItem   MenuItem @relation(fields: [menuItemId], references: [id])
  name       String   @db.VarChar(100)
  price      Int
  quantity   Int
  fieldsJson String   @db.Text

  @@index([orderId])
  @@index([menuItemId])
  @@map("order_items")
}

model OrderFeedback {
  id        String   @id @default(uuid())
  orderId   String   @unique
  order     Order    @relation(fields: [orderId], references: [id])
  rating    Int
  comment   String?  @db.Text
  createdAt DateTime @default(now())

  @@index([orderId])
  @@map("order_feedback")
}

model DiscountCode {
  id        Int       @id @default(autoincrement())
  tenantId  String?   @db.VarChar(36)
  code      String    @unique @db.VarChar(50)
  type      String    @default("percent") @db.VarChar(10)
  value     Int
  minAmount Int       @default(0)
  maxUses   Int       @default(0)
  usedCount Int       @default(0)
  active    Boolean   @default(true)
  expiresAt DateTime?
  createdAt DateTime  @default(now())

  @@index([tenantId])
  @@map("discount_codes")
}

model Broadcast {
  id          Int      @id @default(autoincrement())
  tenantId    String?  @db.VarChar(36)
  message     String   @db.Text
  sentCount   Int      @default(0)
  failedCount Int      @default(0)
  createdAt   DateTime @default(now())

  @@index([tenantId])
  @@map("broadcasts")
}

model Message {
  id            String           @id @default(uuid())
  tenantId      String?          @db.VarChar(36)
  customerPhone String           @db.VarChar(20)
  body          String           @db.Text
  direction     MessageDirection
  orderId       String?
  order         Order?           @relation(fields: [orderId], references: [id])
  twilioSid     String?          @unique @db.VarChar(100)
  createdAt     DateTime         @default(now())

  @@index([tenantId])
  @@index([customerPhone])
  @@index([orderId])
  @@map("messages")
}

model BotSession {
  id            String   @id @default(uuid())
  tenantId      String?  @db.VarChar(36)
  customerPhone String   @db.VarChar(20)
  state         String   @default("IDLE") @db.VarChar(50)
  cartJson      String   @db.Text
  contextJson   String   @db.Text
  lastActive    DateTime @default(now()) @updatedAt

  @@unique([customerPhone, tenantId])
  @@index([tenantId])
  @@map("bot_sessions")
}

model BotRule {
  id        Int      @id @default(autoincrement())
  tenantId  String?  @db.VarChar(36)
  sortOrder Int      @default(0)
  label     String   @db.VarChar(200)
  state     String   @default("*") @db.VarChar(50)
  condition String   @default("contains") @db.VarChar(50)
  matchText String   @db.VarChar(200)
  reply     String   @db.Text
  nextState String   @default("SAME") @db.VarChar(50)
  active    Boolean  @default(true)
  updatedAt DateTime @updatedAt

  @@index([tenantId])
  @@map("bot_rules")
}

model BotMessage {
  id        String   @id @default(uuid()) @db.VarChar(36)
  key       String   @db.VarChar(100)
  tenantId  String   @db.VarChar(36)
  label     String   @db.VarChar(200)
  value     String   @db.Text
  updatedAt DateTime @updatedAt

  @@unique([key, tenantId])
  @@index([tenantId])
  @@map("bot_messages")
}

model OtpSession {
  id        String   @id @default(uuid())
  tenantId  String?  @db.VarChar(36)
  phone     String   @db.VarChar(20)
  codeHash  String   @db.VarChar(100)
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([tenantId])
  @@index([phone])
  @@map("otp_sessions")
}

model Booking {
  id            String        @id @default(uuid())
  tenantId      String?       @db.VarChar(36)
  orderId       String        @unique
  order         Order         @relation(fields: [orderId], references: [id])
  shortId       String        @unique @db.VarChar(20)
  customerPhone String        @db.VarChar(20)
  customerName  String        @db.VarChar(100)
  customerAge   Int?
  preferredDate String        @db.VarChar(50)
  preferredTime String        @db.VarChar(50)
  confirmedDate String?       @db.VarChar(50)
  confirmedTime String?       @db.VarChar(50)
  status        BookingStatus @default(PENDING)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([tenantId])
  @@index([customerPhone])
  @@index([status])
  @@map("bookings")
}

enum OrderStatus {
  PENDING
  ACCEPTED
  REJECTED
  PAID
  COMPLETED
}

enum MessageDirection {
  IN
  OUT
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
}
